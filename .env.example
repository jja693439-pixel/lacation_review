# 이 파일을 복사해서 .env 로 만들고 실제 값을 채우세요.
#   cp .env.example .env        (Windows: copy .env.example .env)
# .env 는 .gitignore 에 걸려 있어 깃에 올라가지 않습니다. (.env.example 만 올라감)
# 백엔드(Spring Boot)와 프론트엔드(Vite) 모두 이 파일 하나를 읽습니다.
# 같은 이름의 OS 환경변수를 설정하면 .env 보다 그 값이 우선합니다.

# ── 백엔드 ──────────────────────────────────────────
# PostgreSQL 접속 정보 (DB 이름: place_review)
DB_URL=jdbc:postgresql://localhost:5432/place_review
DB_USERNAME=postgres
DB_PASSWORD=실제_DB_비밀번호

# 카카오 디벨로퍼스 REST API 키 (필수)
KAKAO_REST_API_KEY=카카오_REST_API_키

# 백엔드 포트
SERVER_PORT=8080

# (선택) JPA 설정: 테이블 자동 생성 방식, SQL 로그 출력 여부
# JPA_DDL_AUTO=update
# JPA_SHOW_SQL=true

# ── 프론트엔드 ──────────────────────────────────────
# (선택) dev 서버가 /api 요청을 넘길 백엔드 주소. 기본값은 http://localhost:SERVER_PORT
# API_PROXY_TARGET=http://localhost:8080
